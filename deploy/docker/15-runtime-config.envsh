#!/bin/sh
set -eu

# JSON protege aspas, barras e quebras de linha nos valores públicos.
printf 'window.__APP_CONFIG__ = %s;\n' \
  "$(jq -cn --arg url "$VITE_API_URL" '{VITE_API_URL: $url}')" \
  > /usr/share/nginx/html/runtime-config.js

# O destino é inserido na configuração do Nginx: aceite somente URL HTTP(S).
if ! printf '%s' "$API_PROXY_TARGET" | grep -Eq '^https?://[a-zA-Z0-9._:-]+(/[a-zA-Z0-9._~/%-]*)?$'; then
  echo 'API_PROXY_TARGET deve ser uma URL HTTP(S) sem credenciais, query ou espaços.' >&2
  exit 1
fi
# A barra final mantém o comportamento do proxy Vite: /api/login -> /login.
export API_PROXY_TARGET="${API_PROXY_TARGET%/}"
